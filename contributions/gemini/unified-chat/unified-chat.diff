+        self.command("add_instruction", text="보안 자격증명 파일 접근 금지", kind="instruction", scope="project")
+
+        chat_res = self.command(
+            "send_chat_request",
+            text="통합 채팅 상태 저장 구조를 어떻게 설계할까?",
+            providers=["codex", "claude"],
+            client_request_id="req-for-review",
